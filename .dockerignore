# Version control + local dev state
.git/
.gitignore
.venv/
venv/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Agent / planning scaffolding + docs (not needed to run the app)
.claude/
.superpowers/
graphify-out/
docs/
*.md

# Secrets — never bake env files into an image
.env
.env.*

# Frontend build inputs (the SPA is served by Caddy from the host bind-mount)
frontend/node_modules/
frontend/.env*
