# Max entity labels any one chunk's extraction prompt may carry (default: 8).
GRAPH_CHUNK_SLICE_SIZE
# Chunk extractions in flight at once - the incremental-insert window size (default: 5).
GRAPH_CHUNK_PARALLELISM
# Retries per failing chunk before it is skipped as a terminal error (default: 2).
GRAPH_EXTRACTION_CHUNK_RETRIES
# Max triples one extractor may pull from a single chunk (default: 30).
GRAPH_EXTRACTION_MAX_TRIPLETS
# Chunks a proposed label must appear in before vocabulary promotion (default: 1).
GRAPH_PROMOTION_MIN_CHUNKS
# Distinct labels sampled to build a dataset's vocabulary (default: 12).
GRAPH_VOCABULARY_SAMPLE_SIZE
# Ceiling on the labels kept in a dataset's vocabulary (default: 200).
GRAPH_VOCABULARY_MAX_LABELS

